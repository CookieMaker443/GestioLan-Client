<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<!-- POPUP: menu a tendina del profilo (avatar in alto a destra nella dashboard).
     "Pannello admin" va mostrato solo agli admin: adminButton.setVisible/Managed(isAdmin). -->
<VBox fx:id="root" styleClass="popup-menu" maxWidth="180" maxHeight="-Infinity"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.cookie.progetti.controllers.Dashboard.ProfileMenuController">
    <Button fx:id="profileButton" styleClass="btn-menu-item" text="%menu.profile" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#onProfile"/>
    <Button fx:id="settingsButton" styleClass="btn-menu-item" text="%menu.settings" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#onSettings"/>
    <Button fx:id="creditsButton" styleClass="btn-menu-item" text="%menu.credits" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#onCredits"/>
    <Button fx:id="adminButton" styleClass="btn-menu-item" text="%menu.admin" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#onAdmin"/>
    <Button fx:id="logoutButton" styleClass="btn-menu-item, btn-menu-item-danger" text="%menu.logout" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#onLogout"/>
</VBox>
